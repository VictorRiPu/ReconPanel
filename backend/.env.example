# Copia este fichero a `backend/.env` y rellena los valores.
# El backend lo carga automáticamente al arrancar (python-dotenv).

# Clave de API de Anthropic — SOLO necesaria para el resumen ejecutivo con IA
# de la fase 6 (Generación de reporte). El resto de la app funciona sin ella.
# Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=
